# Production environment values for stocs-auth: THE NON-SECRET HALF.
#
# Committed on purpose, same contract as stocs-bids' equivalent file. The deploy
# workflow reads this for the non-secret half, pulls the secret half from GitHub
# Secrets, and writes both into the App Platform spec's envs block.
#
# Deliberately NOT named .env.production: that filename is gitignored because Laravel
# loads .env.{APP_ENV} at boot, so it means "the real file, with secrets in it". This
# file is inert data that nothing loads.
#
# THE RULE: a value belongs here only if it is neither generated nor sensitive.
# APP_KEY, DB_PASSWORD and MAIL_PASSWORD are the three secrets, and they live in
# GitHub Secrets.
#
# ---------------------------------------------------------------------------
# THIS IS DELIBERATELY MINIMAL
#
# The running app sets 29 env vars and relies on framework defaults for everything
# else, unlike stocs-bids which sets 68. This file matches that, rather than becoming
# exhaustive, because `doctl apps update --spec` replaces the whole spec: adding keys
# here means adding config to a working service, and every addition is a change to
# review rather than a default to inherit. Values were read off the running app with
# `doctl apps spec get`, not from .env.example, which does not reflect reality.

# --- App ---
APP_NAME="Stocs Auth"
APP_ENV=production
APP_DEBUG=false
# ${APP_URL} is a DigitalOcean binding to the app's own URL, copied from the running
# app. It follows the app through a rename, unlike a hardcoded hostname.
#
# NOTE FOR THE DEPLOY WORKFLOW: values here must be copied into the spec literally. If
# the workflow shell-expands them, ${APP_URL} becomes empty or self-referential rather
# than reaching DigitalOcean intact.
APP_URL=${APP_URL}

# --- Logging ---
# stderr, never storage/logs: App Platform storage is ephemeral and is lost per deploy.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database ---
# Set as bindings in the app spec (.do/app.yaml) rather than here, so the values live in
# neither the repo nor GitHub and follow the cluster if it moves.
#
# TWO THINGS WORTH CHANGING, both left as the live app has them because auth is the login
# path for the consumer site: getting either wrong takes bids login down entirely, and OTP
# is the only way consumers authenticate. Neither should be changed without checking first.
#
# (Scope note: stocs-b2b does NOT currently authenticate through this service. Unifying
# them is a future intention, and when it happens the blast radius here widens from bids
# to both sites.)
#
#   1. The app connects as `doadmin`, the cluster SUPERUSER, which can read and write
#      every database on the cluster: bids', b2b's, prize-draw's. That holds regardless of
#      which apps authenticate through auth, because the cluster is shared, so a
#      compromise of auth reaches data unrelated to identity. For the service that owns
#      identity that is the wrong end of least-privilege. A dedicated `auth_2026_07` user
#      already exists on the cluster and is unused. Switching means confirming it has full
#      privileges on stocs_auth_prod first, because getting it wrong means auth cannot boot.
#   2. DB_HOST is the cluster's PUBLIC endpoint. The private one
#      (private-stocs-main-do-user-...) keeps traffic on DigitalOcean's network. The
#      cluster's trusted sources are properly maintained, listing all six apps plus
#      specific IPs, so this is defence in depth rather than an exposure.
#
# Note also that the live app sets DATABASE_URL from a binding, but Laravel reads DB_URL
# (config/database.php), so that variable is currently dead. It is not carried here.

# --- Session / cache / queue ---
# cookie, matching the running app and stocs-bids. Switching to database would log
# everyone out and add a DB round-trip per request.
SESSION_DRIVER=cookie
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Sanctum ---
# 24 hours. Auth's own hard rules require tokens to expire; non-expiring tokens are
# treated as a security defect in this repo.
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440

# --- CORS ---
# Empty on the running app, and correct for now: nothing calls auth from a browser.
# stocs-bids calls it server-to-server, where CORS does not apply, and the consumer
# frontend talks to bids on its own origin.
#
# An empty list means no cross-origin request is allowed, which is the safe default. If
# a browser client is ever pointed at auth directly (a Flutter web build, an SPA), add
# its origin explicitly. Never "*": auth's hard rules forbid it.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

# --- Mail (shared Gmail SMTP across all STOCS apps; MAIL_PASSWORD is a secret) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=no-reply@stocs.com
MAIL_FROM_ADDRESS=no-reply@stocs.com
MAIL_FROM_NAME=STOCS

# --- OTP delivery ---
# mail, so codes are emailed via the SMTP mailer above. `file` writes them to
# storage/otp-codes.txt and is for local dev only.
#
# OtpCodeEmail implements ShouldQueue, so this depends on the queue worker in
# .do/app.yaml running. Without it no code is ever delivered and nobody can log in to
# the consumer site at all, while the service itself looks healthy.
OTP_NOTIFIER=mail

# --- Operator admins ---
# Deliberately absent, matching the running app, which sets no ADMIN_* vars.
#
# config/admins.php reads ADMIN_1_EMAIL / _PASSWORD / _NAME and up, and AdminUsersSeeder
# creates a super-admin per populated slot. The migrate job does NOT seed, so these are
# only needed for a one-off seeding run after a first deploy into an empty database:
#
#   doctl apps console <APP_ID> --component api
#   php artisan db:seed --class=AdminUsersSeeder
#
# They have to be present in the app environment at that moment. Entries with a missing
# email or password are skipped, so an unset slot is inert rather than broken.
#
# Do not add them permanently and do not seed on deploy: the seeder reapplies the
# password every run, so it would silently revert a password an operator changed.
