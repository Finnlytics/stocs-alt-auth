# Staging environment values for stocs-auth: THE NON-SECRET HALF.
#
# Same contract and same key set as .env.production.example; read that file's header for
# the rules and for the two database changes worth making. This file records only what
# differs.
#
# Staging is the stocs-auth app that exists today (it was the test server).
#
# WHAT DIFFERS FROM PRODUCTION:
#
#   APP_ENV=staging   Not "production", which is what the app currently runs. This is
#                     not cosmetic: MintTestUsersRequest::authorize() returns
#                     `! app()->isProduction()`, so the dev-only
#                     POST /api/v1/service/test-users/mint endpoint is 403 today. That
#                     endpoint is what bids' `bids:simulate-http` load harness uses to
#                     mint tokens, so the HTTP load test cannot run against staging auth
#                     as things stand. Switching to staging unblocks it.
#
#                     Unlike stocs-bids, nothing else in auth branches on the
#                     environment name: there are no other app()->environment() calls in
#                     app/, config/ or routes/, so this change has no other effect.
#
#   APP_NAME          Marked as staging, so it is distinguishable in outbound OTP mail.
#   LOG_LEVEL=debug   Verbose on purpose: this is where things are meant to break.
#
# Everything else mirrors production, so what passes here is representative.

# --- App ---
APP_NAME="Stocs Auth (Staging)"
APP_ENV=staging
APP_DEBUG=false
APP_URL=${APP_URL}

# --- Logging ---
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Database ---
# Bindings in .do/app.staging.yaml. See .env.production.example for the doadmin and
# public-endpoint notes, which apply equally here. Staging is the better place to prove
# a switch to the dedicated auth_2026_07 user before production depends on it.

# --- Session / cache / queue ---
SESSION_DRIVER=cookie
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Sanctum ---
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440

# --- CORS ---
# Empty, as in production: nothing calls auth from a browser. See the production file.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

# --- Mail (shared Gmail SMTP; MAIL_PASSWORD is a secret) ---
# Real SMTP, so OTP login is actually testable end to end. The consequence is that
# staging emails real addresses, so keep its user data seeded with addresses you own.
# MAIL_MAILER=log would silence outbound mail, at the cost of making OTP login
# untestable, which is most of what this service does.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=no-reply@stocs.com
MAIL_FROM_ADDRESS=no-reply@stocs.com
MAIL_FROM_NAME=STOCS

# --- OTP delivery ---
# mail, matching production, so the queue worker dependency is exercised here too:
# OtpCodeEmail is queued, so no worker means no login.
OTP_NOTIFIER=mail

# --- Operator admins ---
# Absent, as in production. See .env.production.example for the one-off seeding command
# and why they are not set permanently.
